# Copy this file to docker/.env and review the values before the first start.
COMPOSE_PROJECT_NAME=kanboard-qa

KANBOARD_PORT=8080

POSTGRES_PORT=5432
POSTGRES_DB=kanboard
POSTGRES_USER=kanboard
# For values containing # or $, follow Docker Compose .env quoting rules.
POSTGRES_PASSWORD=replace_with_local_dev_password

JENKINS_PORT=8081
